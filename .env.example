# No URL means clearly labeled, simulated demonstration data.
# Keep credentials on the server; never use a VITE_ variable for secrets.
XML_SERVICE_URL=
# Optional Authorization header, e.g. Bearer <token> or Basic <base64>.
XML_SERVICE_AUTHORIZATION=
POLL_INTERVAL_MS=2000
# Optional JSON file for mapping a service-specific XML format; see README.
XML_TAG_MAP=
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Retain at most 30 days. History is stored on this server, shared across devices.
HISTORY_RETENTION_DAYS=30
# Production browser origin when separately hosted. Vite's proxy needs no override.
CLIENT_ORIGIN=http://localhost:5173
